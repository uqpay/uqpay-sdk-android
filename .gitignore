# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Local config — contains SDK paths and (for sample-app) sandbox keys. Never commit.
local.properties

# Secrets & credentials — never commit
*.jks
*.keystore
*.pem
*.p12
secrets.*
*.secret

# docs/ — the merchant-facing docs (integration guide, API reference, error codes,
# troubleshooting, etc.) are release deliverables (acceptance-criteria.md §12) and ARE
# tracked. Only internal working material under docs/ is ignored: research specs, planning
# and progress notes, audit reports, and the reference-SDK clones.
#
# `!docs/` exists because some developer machines ignore `docs/` in ~/.gitignore_global;
# a repository rule outranks the global one, so the deliverables stay visible everywhere.
!docs/
docs/spec/
docs/reference-sdks/
docs/**/*-gaps.md
docs/**/*-audit.md
docs/**/*PROGRESS*.md
docs/**/*STATUS*.md
docs/**/*HANDOFF*.md
docs/internal/
docs/plans/
docs/notes/

# Agent/assistant instructions — local working material, not repository content.
# Already covered by ~/.gitignore_global, repeated here so the rule travels with the repo.
CLAUDE.md
.claude/

# OS
.DS_Store

# Logs / reports
*.log
