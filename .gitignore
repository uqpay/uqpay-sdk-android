# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Local config — contains SDK paths and (for sample-app) sandbox keys. Never commit.
local.properties

# Secrets & credentials — never commit
*.jks
*.keystore
*.pem
*.p12
secrets.*
*.secret

# docs/ is not tracked. It holds internal working notes (progress, planning, research
# specs, audit reports) alongside the reference-SDK clones, and is treated as local
# working material rather than repository content. Kept on disk, never committed.
#
# Listed explicitly rather than relying on ~/.gitignore_global ignoring `docs/`
# machine-wide, so the rule travels with the repo.
#
# NOTE: acceptance-criteria.md §12 lists the integration guide, API reference, error
# codes, and troubleshooting docs as release deliverables, and CLAUDE.md requires
# api-reference.md to change alongside any public API change. Both now depend on a
# process outside this repository.
docs/

# Agent/assistant instructions — local working material, not repository content.
# Already covered by ~/.gitignore_global, repeated here so the rule travels with the repo.
CLAUDE.md
.claude/

# OS
.DS_Store

# Logs / reports
*.log
