# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Local config — contains SDK paths and (for sample-app) sandbox keys. Never commit.
local.properties

# Secrets & credentials — never commit
*.jks
*.keystore
*.pem
*.p12
secrets.*
*.secret

# docs/ is NOT tracked in this repository. Merchant documentation is distributed
# outside the public repo; internal material (specs, plans, notes, audits, the
# reference-SDK clones) and release secrets (docs/secrets/ — GPG signing key and
# passphrase) must never be tracked either. ~/.gitignore_global already ignores
# docs/; this repeats the rule so it travels with the repo and no `!docs/`
# override re-exposes any of it.
docs/

# Agent/assistant instructions — local working material, not repository content.
# Already covered by ~/.gitignore_global, repeated here so the rule travels with the repo.
CLAUDE.md
.claude/

# OS
.DS_Store

# Logs / reports
*.log
