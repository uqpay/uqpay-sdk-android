<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SampleApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UQPaySample">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The same checkout in Java. Not exported: it is reached from MainActivity, and
             a demo screen that creates payment intents has no business being launchable
             by another app. -->
        <activity
            android:name=".JavaCheckoutActivity"
            android:exported="false" />
    </application>

</manifest>
