    <string name="uqpay_back_to_methods">Back to payment methods</string>
    <string name="uqpay_cd_back_to_methods">Back to payment methods</string>

    <!-- Confirming (§2c: back-press is blocked here, and the customer must see why) -->
    <string name="uqpay_confirming">Processing your payment…</string>
    <string name="uqpay_confirming_blocked">Confirming your payment. Please don\'t leave this screen.</string>
    <string name="uqpay_confirming_blocked_hint">This usually takes a few seconds.</string>
    <string name="uqpay_cd_confirming">Confirming your payment</string>

    <!-- Waiting for the gateway with nothing for the customer to do -->
    <string name="uqpay_polling">Waiting for confirmation…</string>
    <string name="uqpay_cd_polling">Waiting for confirmation</string>

    <!-- A next step this SDK version cannot yet show (Slices 4 and 5) -->
    <string name="uqpay_action_pending_title">Almost there</string>
    <string name="uqpay_action_qr">Scan the QR code to complete your payment.</string>
    <string name="uqpay_action_redirect">Complete the verification step to continue.</string>
    <string name="uqpay_action_bank_details">Complete the transfer to finish your payment.</string>
    <string name="uqpay_action_unknown">Complete the payment in your banking or wallet app.</string>
    <string name="uqpay_action_still_waiting">We\'ll update as soon as the payment is confirmed.</string>

    <!-- Leaving while an attempt is in the air (M-3 / M-4: a visible way out) -->
    <string name="uqpay_cancel">Cancel</string>
    <string name="uqpay_cd_cancel">Cancel and leave this screen</string>

    <!-- ==========================================================================
