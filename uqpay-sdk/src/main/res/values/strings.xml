    <string name="uqpay_cd_loading">Loading payment</string>

    <!-- Method list -->
    <string name="uqpay_choose_method">Choose how to pay</string>
    <string name="uqpay_no_methods">No payment methods are available for this payment.</string>
    <string name="uqpay_cd_method_format">Pay with %1$s</string>

    <!-- Method names. Keyed by the wire type; see PaymentMethodType. -->
