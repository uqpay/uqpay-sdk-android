<?xml version="1.0" encoding="utf-8"?>
<!--
  Every customer-facing string of the payment UI. Nothing in Kotlin may hardcode UI text:
  strings live here so they can be localised without touching code (English only in V1),
  and so a reviewer can read the whole customer-visible vocabulary in one place.

  Prefixed `uqpay_` because this is a library: resource names are merged into the host
  app's namespace, and an unprefixed `cancel` would collide with (or be silently overridden
  by) a merchant's own string of the same name.
-->
<resources>

    <!-- Screen chrome -->
    <string name="uqpay_title">Payment</string>
    <string name="uqpay_cd_close">Close payment</string>
    <string name="uqpay_amount_format">%1$s %2$s</string>
    <string name="uqpay_order_format">Order %1$s</string>

